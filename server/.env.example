# CareCircle Server Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=carecircle-super-secret-jwt-key-replace-in-production-min-32-chars
CRON_SECRET=carecircle-cron-secret-token-for-tick-api

# Google Firebase / Firestore (Server-side Admin SDK)
# For production: set your Firebase service account credentials.
# If not set or USE_MOCK_FIRESTORE=true, the server uses a high-fidelity local in-memory/file-backed Firestore store for instant development & zero-friction testing.
USE_MOCK_FIRESTORE=false
FIREBASE_PROJECT_ID=carecircle-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-carecircle@carecircle-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Email Notification via Gmail SMTP (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
EMAIL_FROM="CareCircle Support" <no-reply@carecircle.app>
